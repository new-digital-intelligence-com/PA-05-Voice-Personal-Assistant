# ---- Anthropic ----
ANTHROPIC_API_KEY=sk-ant-...
# Model used for every turn of the tool-use loop.
ANTHROPIC_MODEL=claude-haiku-4-5

# ---- ElevenLabs (her voice) ----
# https://elevenlabs.io/app/settings/api-keys — leave blank to fall back to the
# browser's built-in voice.
ELEVENLABS_API_KEY=
# Voice from https://elevenlabs.io/app/voice-library (default: Rachel, female).
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# ---- Google OAuth ----
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ---- App ----
APP_URL=http://localhost:3000
# Any 32+ random bytes: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---- Her face (optional) ----
# Blank uses the bundled head in public/avatar.glb. To use your own, make one at
# https://readyplayer.me, then paste the GLB URL with ARKit morph targets:
#   https://models.readyplayer.me/<id>.glb?morphTargets=ARKit&textureAtlas=1024
NEXT_PUBLIC_AVATAR_URL=
