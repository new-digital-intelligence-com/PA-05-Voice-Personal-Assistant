GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ---- App ----
APP_URL=http://localhost:3000
# Any 32+ random bytes: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
