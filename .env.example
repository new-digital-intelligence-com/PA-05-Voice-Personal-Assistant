# ---- Anthropic ----
ANTHROPIC_API_KEY=sk-ant-...
# Model used for every turn of the tool-use loop.
ANTHROPIC_MODEL=claude-haiku-4-5

# ---- ElevenLabs (her voice) ----
# https://elevenlabs.io/app/settings/api-keys — leave blank to fall back to the
# browser's built-in voice.
ELEVENLABS_API_KEY=
# Voice from https://elevenlabs.io/app/voice-library (default: Rachel, female).
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# ---- Google OAuth ----
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ---- App ----
APP_URL=http://localhost:3000
# Any 32+ random bytes: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=


# ---- D-ID (her photoreal face) ----
# https://studio.d-id.com -> Account -> API Key. Without it, Face mode is disabled and
# Chat mode still works.
DID_API_KEY=
# Voice D-ID speaks with. "microsoft" voices are included; set DID_VOICE_PROVIDER to
# elevenlabs to use your ElevenLabs voice instead (configure the key in D-ID first).
DID_VOICE_ID=en-US-JennyNeural
DID_VOICE_PROVIDER=microsoft
# Video height of her stream. 1080 is sharpest; drop to 720 or 512 for a faster first
# frame and cheaper credits.
DID_OUTPUT_RESOLUTION=1080
# Seconds an idle stream is kept alive. Shorter frees the account's concurrent-session
# slot faster after a closed tab; too short and she disconnects mid-conversation.
DID_SESSION_TIMEOUT=180
